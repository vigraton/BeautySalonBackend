generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model UserDetails {
  fullname String
  email String @unique
  telephone String
  observations String
}

model Services {
  id String @id @default(uuid())
  name String
  description String
  price Decimal @db.Decimal(10,2)

  @@map("services")
}

model Appointment {
  id String @id @default(uuid())
  service String
  stylist String
  day DateTime @default(now())
  time DateTime
  details UserDetails
}