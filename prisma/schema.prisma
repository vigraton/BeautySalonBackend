generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url  	    = env("DATABASE_URL")
}

model UserDetails {
  id String @id @default(uuid())
  fullname String
  email String @unique
  telephone String
  observations String

  scheduled Schedule @relation(fields: [scheduled_id], references:[id])
  scheduled_id String
}

model Service {
  id String @id @default(uuid())
  name String
  description String
  duration String
  price Decimal @db.Decimal(10,2)

  professional Stylist @relation(fields: [stylist_id], references:[id])
  stylist_id String

  @@map("services")
}

model Stylist {
  id String @id @default(uuid())
  name String
  specialistIn String
  description String

  service Service @relation(fields: [service_id], references: [id])
  service_id String
  
  appointments Appointment[]

  @@map("stylists")
}

model Schedule {
  id String @id @default(uuid())
  day DateTime
  
  user_id UserDetails @relation(fields: [user_id], references:[id])
  user_id String
}

model Appointment {
  id String @id @default(uuid())

  userDetails UserDetails @relation(fields: [user_id], references:[id])
  user_id String

  schedule Schedule @relation(fields: [schedule_id], references:[id])
  schedule_id String 

  stylist Stylist @relation(fields: [stylist_id], references:[id])
  stylist_id String 

  service Service @relation(fields: [service_id], references:[id])
  service_id String 
}