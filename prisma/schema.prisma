generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model UserDetails {
  id           String @id @default(uuid())
  fullname     String
  email        String @unique
  telephone    String
  observations String?

  appointments Appointment[]

  @@map("users")
}

model Service {
  id          String  @id @default(uuid())
  name        String @unique
  description String
  duration    String
  price       Decimal @db.Decimal(10, 2)

  appointments Appointment[]

  @@map("services")
}

model Stylist {
  id           String @id @default(uuid())
  name         String @unique
  specialistIn String
  description  String

  appointments Appointment[]

  @@map("stylists")
}

model Schedule {
  id  String   @id @default(uuid())
  day DateTime

  appointments Appointment[]

  @@map("schedules")
}

model Appointment {
  id String @id @default(uuid())

  userDetails UserDetails @relation(fields: [user_id], references: [id])
  user_id     String

  schedule    Schedule @relation(fields: [schedule_id], references: [id])
  schedule_id String

  stylist    Stylist @relation(fields: [stylist_id], references: [id])
  stylist_id String

  service    Service @relation(fields: [service_id], references: [id])
  service_id String

  @@map("appointments")
}
